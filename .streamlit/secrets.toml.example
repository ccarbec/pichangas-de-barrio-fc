# Copia este archivo a ".streamlit/secrets.toml" (sin ".example") y completa
# tus datos reales de Turso. Ese archivo NO se sube a git (está en .gitignore).
#
# Si dejas "secrets.toml" sin crear, o sin estas dos claves, la app funciona
# igual pero guardando los datos en el archivo local data/pichangas.db.
#
# En Streamlit Community Cloud, estas mismas dos claves se pegan en
# "Settings -> Secrets" de la app (no como archivo, sino directo en el panel).

TURSO_DATABASE_URL = "libsql://pichangas-tu-usuario.turso.io"
TURSO_AUTH_TOKEN = "tu-token-generado-con-turso-db-tokens-create"
